# Copy this file to .env.local (which is git-ignored) and fill in your key.
# Get one free at https://resend.com — no credit card needed for the
# sandbox tier used by the contact chat widget.
RESEND_API_KEY=

# Portfolio AI assistant. Keep these server-side; never use NEXT_PUBLIC_.
# Choose a Responses API model available in your OpenAI project.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
